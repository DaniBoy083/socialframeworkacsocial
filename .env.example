# Exemplo sem segredos. Copie para .env.local; nunca versione valores reais.
DATABASE_URL=
SOCIAL_CLINIC_ID=
APP_ORIGIN=http://localhost:3000
SOCIAL_API_URL=http://127.0.0.1:8000
ENVIRONMENT=development
# Login fixo: "Serviço social" e "Tecnologia" (nomes institucionais exatos).
# Esta política define permissões de módulos; não amplia as equipes de login.
# Mantenha desativada até a homologação da matriz de operações.
SOCIAL_POLICY_APPROVED=false
SOCIAL_ACCESS_POLICY={}
SESSION_HOURS=8
